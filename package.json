{
  "name": "tiktok-web-api",
  "version": "1.0.0",
  "private": true,
  "description": "Pure-HTTP TikTok web API client with reverse-engineered webmssdk (X-Bogus) signing, exposed as a NestJS service.",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "docker compose up --build",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "setup": "python3 -m pip install --user curl_cffi || pip3 install --user curl_cffi",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "node-tls-client": "^2.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
